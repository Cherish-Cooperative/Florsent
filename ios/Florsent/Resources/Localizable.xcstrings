    "grounding.returnNight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go rest"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去休息吧"
          }
        }
      },
      "comment": "Android: grounding_return_bedtime"
    },
