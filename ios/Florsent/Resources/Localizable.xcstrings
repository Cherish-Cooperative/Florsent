    "breathe.rhythm.a11y": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rhythm %@ seconds"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "節奏 %@ 秒"
          }
        }
      },
      "comment": "VoiceOver: the pattern's rhythm, e.g. 4, 7, 8"
    },
    "breathe.secondsLeft": {
