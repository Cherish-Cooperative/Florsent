    "shortcut.step1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Shortcuts, tap Automation › + › App. Choose your watched apps, tick “Is Opened” and “Run Immediately”, then Next"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開「捷徑」，點「自動化」›「＋」›「App」。選好社群 App，勾「已開啟」與「立即執行」，點「下一步」"
          }
        }
      }
    },
    "shortcut.step2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search “Florsent” and add “Over budget right now?”. Then search and add “If”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋「Florsent」，加入「現在超過額度了嗎？」，再搜尋並加入「如果」"
          }
        }
      }
    },
    "shortcut.step3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search “Color Filters” and drag “Set Color Filters” inside the If"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋「顏色濾鏡」，把「設定顏色濾鏡」拖進「如果」裡"
          }
        }
      }
    },
    "shortcut.step4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make one more App automation with “Is Closed”: add “Set Color Filters” and switch it to “Off”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再新增一個「已關閉」的 App 自動化：加入「設定顏色濾鏡」，把「開啟」改成「關閉」"
          }
        }
      }
    },
