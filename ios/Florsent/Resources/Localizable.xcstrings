    "home.guidance.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time support comes in the next version. Breathing and grounding already work"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下一版會接上「螢幕使用時間」，呼吸練習和回到當下現在就能用"
          }
        }
      }
    },
    "home.guidance.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentle guidance on iPhone"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 上的漸進引導"
          }
        }
      }
    },
    "home.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe for a minute, then get back to life"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "花一分鐘呼吸，然後回到生活"
          }
        }
      },
      "comment": "Android: onboarding_step_breathe"
    },
    "intent.breathe.description": {
      "extractionState": "manual",
      "localizations": {
