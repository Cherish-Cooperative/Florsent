{
  "sourceLanguage": "en",
  "strings": {
    "auth.hint.account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to your Apple Account in Settings first"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在「設定」登入 Apple 帳號"
          }
        }
      }
    },
    "auth.hint.conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time is already managed by another app or family"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「螢幕使用時間」已由其他 App 或家人管理"
          }
        }
      }
    },
    "auth.hint.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time access wasn't granted. Tap to try again"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有取得「螢幕使用時間」權限，點一下再試"
          }
        }
      }
    },
    "auth.hint.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs a connection. Try again in a moment"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要網路連線，請稍後再試"
          }
        }
      }
    },
    "auth.hint.passcode": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on a device passcode in Settings first"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在系統「設定」開啟裝置密碼"
          }
        }
      }
    },
    "auth.hint.restricted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time is restricted on this device"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這台裝置的「螢幕使用時間」受到限制"
          }
        }
      }
    },
    "bedtime.needsGuidance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on gentle guidance first"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先開啟溫柔引導"
          }
        }
      }
    },
    "bedtime.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most two reminders a night, until 5 AM"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每晚最多提醒兩次，到清晨 5 點"
          }
        }
      }
    },
    "bedtime.offShort": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未開啟"
          }
        }
      }
    },
    "bedtime.suggest.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before sleep, try 4-7-8"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "睡前試試 4-7-8 呼吸"
          }
        }
      }
    },
    "bedtime.suggest.try": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try 4-7-8 now"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在試試 4-7-8"
          }
        }
      }
    },
    "bedtime.suggest.use": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 4-7-8"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改用 4-7-8"
          }
        }
      }
    },
    "bedtime.threshold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrolling before a reminder"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒前可以滑多久"
          }
        }
      }
    },
    "bedtime.time": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedtime"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想睡的時間"
          }
        }
      }
    },
    "bedtime.title": {
      "extractionState": "manual",
      "localizations": {
