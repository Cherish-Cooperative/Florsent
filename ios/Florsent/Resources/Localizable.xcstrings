    "greeting.night": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's late, time to rest"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "夜深了，早點休息"
          }
        }
      },
