    "greeting.afternoon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good afternoon"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "午安"
          }
        }
      },
      "comment": "Android: greeting_afternoon"
    },
    "greeting.evening": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good evening"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "晚上好"
          }
        }
      },
      "comment": "Android: greeting_evening"
    },
    "greeting.morning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good morning"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "早安"
          }
        }
      },
      "comment": "Android: greeting_morning"
    },
    "greeting.night": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's late, time to rest"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "夜深了，早點休息"
          }
        }
      },
      "comment": "Android: greeting_night"
    },
    "grounding.another": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another one"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "換一句"
          }
        }
      },
      "comment": "Android: grounding_another"
    },
    "grounding.day.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look around and find three green things"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看看四周，找出三樣綠色的東西"
          }
        }
      },
      "comment": "Android: grounding_prompts[0]"
    },
    "grounding.day.10": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a deep breath and notice what the air smells like"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "深深吸一口氣，聞聞空氣裡有什麼味道"
          }
        }
      },
      "comment": "Android: grounding_prompts[9]"
    },
    "grounding.day.11": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find the brightest color in front of you and rest your eyes on it"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留意眼前最亮的那個顏色，靜靜看它一會兒"
          }
        }
      },
      "comment": "Android: grounding_prompts[10]"
    },
    "grounding.day.12": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk to someone nearby, or look up at the sky"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟身邊的人說說話，或抬頭看看天空"
          }
        }
      },
      "comment": "Android: grounding_prompts[11]"
    },
    "grounding.day.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feel the weight of your feet on the ground"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "感受雙腳踩在地上的重量"
          }
        }
      },
      "comment": "Android: grounding_prompts[1]"
    },
    "grounding.day.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put the phone down, pour a glass of water and drink it slowly"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放下手機，去倒杯水，慢慢喝完"
          }
        }
      },
      "comment": "Android: grounding_prompts[2]"
    },
    "grounding.day.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen: what is the farthest sound you can hear?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聽聽看，現在離你最遠的聲音是什麼？"
          }
        }
      },
      "comment": "Android: grounding_prompts[3]"
    },
    "grounding.day.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let your shoulders relax and sink a little"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓肩膀放鬆，往下沉一點點"
          }
        }
      },
      "comment": "Android: grounding_prompts[4]"
    },
    "grounding.day.6": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look out the window at the farthest point and rest your eyes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看向窗外最遠的地方，讓眼睛休息一下"
          }
        }
      },
      "comment": "Android: grounding_prompts[5]"
    },
    "grounding.day.7": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch something nearby and notice its warmth and texture"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "摸摸身邊的東西，感覺它的溫度和觸感"
          }
        }
      },
      "comment": "Android: grounding_prompts[6]"
    },
    "grounding.day.8": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand up and stretch, letting your back slowly lengthen"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "站起來伸個懶腰，讓背慢慢延展開"
          }
        }
      },
      "comment": "Android: grounding_prompts[7]"
    },
    "grounding.day.9": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think of one small thing that went well today"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想一件今天還不錯的小事"
          }
        }
      },
      "comment": "Android: grounding_prompts[8]"
    },
    "grounding.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to the present"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到當下"
          }
        }
      },
      "comment": "Android: grounding_label"
    },
    "grounding.night.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge your phone somewhere out of reach"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把手機放到伸手拿不到的地方充電"
          }
        }
      },
      "comment": "Android: grounding_prompts_bedtime[0]"
    },
    "grounding.night.2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dim the lights in your room a little"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把房間的燈調暗一點"
          }
        }
      },
      "comment": "Android: grounding_prompts_bedtime[1]"
    },
    "grounding.night.3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomorrow's things can wait until tomorrow"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明天的事，明天再想就好"
          }
        }
      },
      "comment": "Android: grounding_prompts_bedtime[2]"
    },
    "grounding.night.4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Breathe out slowly and let your shoulders relax"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "深深吐一口氣，讓肩膀放鬆下來"
          }
        }
      },
      "comment": "Android: grounding_prompts_bedtime[3]"
    },
    "grounding.night.5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a small sip of warm water and get ready for bed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "喝一小口溫水，準備躺下"
          }
        }
      },
      "comment": "Android: grounding_prompts_bedtime[4]"
    },
    "grounding.night.6": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think of one small thing you're grateful for today"
          }
        },
        "zh-Hant": {
          "stringUnit": {
