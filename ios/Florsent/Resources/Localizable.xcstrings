    "intent.overBudget.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells whether your watched apps are over today's budget. Use it in an automation to turn on grayscale"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回報留意的 App 今天是否超過額度，可以在自動化裡用來開啟灰階"
          }
        }
      }
    },
    "intent.overBudget.no": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not yet, still within budget"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有，仍在額度內"
          }
        }
      }
    },
    "intent.overBudget.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Over budget right now?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在超過額度了嗎？"
          }
        }
      }
    },
    "intent.overBudget.yes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, over budget. Time for a break?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "是，已經超過額度了，休息一下吧？"
          }
        }
      }
    },
