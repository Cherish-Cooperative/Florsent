  "strings": {
    "shield.bedtime.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's getting late. A minute of slow breathing helps you settle for sleep"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "夜深了，花一分鐘慢慢呼吸，讓身體準備入睡"
          }
        }
      }
    },
    "shield.bedtime.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time to wind down?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該準備休息了嗎？"
          }
        }
      },
      "comment": "Mirrors Android nudge_message_bedtime"
    },
    "shield.daily.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've been scrolling for a while. A minute of breathing can help"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經滑了一陣子，花一分鐘呼吸一下吧"
          }
        }
      }
    },
    "shield.daily.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time for a break"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "休息一下吧"
          }
        }
      }
    },
    "shield.primary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go breathe"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去呼吸"
          }
        }
      }
    },
    "shield.secondary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5 more minutes"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再滑 5 分鐘"
          }
        }
