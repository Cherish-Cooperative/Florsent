    "shield.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've been scrolling for a while. A minute of breathing can help"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已經滑了一陣子，花一分鐘呼吸一下吧"
