        }
      }
    },
    "shield.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause for a deep breath?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停下來深呼吸一下？"
          }
        }
