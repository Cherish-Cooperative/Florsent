<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and lower. Florsent promises that usage data never leaves the phone, so nothing is
  included in Auto Backup. Keep in sync with data_extraction_rules.xml and PRIVACY.md.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
