    <!-- Prominent disclosure (Google Play AccessibilityService policy) -->
    <string name="disclosure_title">使用無障礙服務</string>
    <string name="disclosure_body">Florsent 透過無障礙服務知道你正在用哪個 App，用來計算留意的 App 用了多久、顯示淡化效果和提醒，並在手機上保存 30 天的使用時段與螢幕開關時間，學習你的作息（隨時可以清除）。\n\n不讀取畫面內容，不記錄你輸入的文字，資料只存在這支手機上。\n\n接著請在系統的無障礙設定中，開啟「Florsent 漸進引導」。</string>
    <string name="disclosure_accept">同意，前往設定</string>
    <string name="disclosure_decline">暫時不要</string>

